[Unit]
Description=Continuous guarded Greenhouse application worker
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=__REPO_DIR__
Environment=PYTHONPATH=__REPO_DIR__/src
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/bin/test -x __REPO_DIR__/.venv/bin/python
ExecStartPre=/usr/bin/test -r __REPO_DIR__/config/candidate_profile_config.json
ExecStartPre=/usr/bin/test -r __REPO_DIR__/config/candidate_email_pool.json
ExecStartPre=/usr/bin/test -r __REPO_DIR__/config/vertex_service_account.json
ExecStart=/usr/bin/xvfb-run -a "--server-args=-screen 0 1280x1024x24" __REPO_DIR__/.venv/bin/python __REPO_DIR__/src/job_automation.py continuous-greenhouse
Restart=always
RestartSec=15
KillSignal=SIGINT
TimeoutStopSec=480
SyslogIdentifier=job-app-greenhouse
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
