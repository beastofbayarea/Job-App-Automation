[Unit]
Description=Continuous VPS job discovery and safe search-output publication
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=900
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=__REPO_DIR__
Environment=PYTHONPATH=__REPO_DIR__/src
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/bin/test -x __REPO_DIR__/.venv/bin/python
ExecStart=/bin/bash __REPO_DIR__/scripts/vps_continuous_search_sync.sh
Restart=always
RestartSec=15
MemoryAccounting=true
MemoryHigh=700M
MemoryMax=1G
TasksMax=128
CPUAccounting=true
CPUWeight=50
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
KillSignal=SIGINT
TimeoutStopSec=120
SyslogIdentifier=job-app-search-sync
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
